    "grammar": [
        {
            "title": "Counting in Ilonggo",
            "description": "Ilonggo has two number systems: native Hiligaynon numbers (used for counting things) and Spanish-influenced numbers (used for money, time, and often in daily speech). We'll learn the native system first.",
            "examples": [
                "Isa (1), Duha (2), Tatlo (3), Apat (4), Lima (5)",
                "Anum (6), Pito (7), Walo (8), Siyam (9), Napulo (10)"
            ]
        },
        {
            "title": "Asking 'How many?' with Pila",
            "description": "'Pila' means 'how many' or 'how much'. Use it to ask about quantity or price.",
            "examples": [
                "Pila? (How much / How many?)",
                "Pila ang plete? (How much is the fare?)"
            ]
        },
        {
            "title": "Time Words: Karon, Bwas, Kahapon",
            "description": "These three words let you place events in time. They work like English 'today/now', 'tomorrow', and 'yesterday'.",
            "examples": [
                "Karon = Today / Right now",
                "Bwas = Tomorrow",
                "Kahapon = Yesterday",
                "Nagkaon ako karon. (I ate today.)",
                "Masakay ako bwas. (I will ride tomorrow.)"
            ]
        }
    ],
