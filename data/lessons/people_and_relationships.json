    "grammar": [
        {
            "title": "Describing People",
            "description": "Adjectives in Ilonggo precede the subject marker 'ang' + noun, or they can follow the noun as well. For people, adjectives like 'gwapa' and 'gwapo' agree with the gender of the person.",
            "examples": [
                "Gwapa ang babaye. (The woman is beautiful.)",
                "Gwapo ang lalake. (The man is handsome.)",
                "Masadya sila. (They are happy.)"
            ]
        },
        {
            "title": "Expressing Want/Like with Luyag",
            "description": "'Luyag' means to like or want something. It's used before 'sang' + object to say what you want.",
            "examples": [
                "Luyag ako sang kape. (I want/like coffee.)",
                "Luyag sila makaon. (They want to eat.)"
            ]
        },
        {
            "title": "Saying 'to Help' with Bulig / Hambal",
            "description": "'Bulig' is help/assist. 'Hambal' is to say or speak. Both are action verbs that follow the nag-/ga-/ma- prefix system.",
            "examples": [
                "Nagbulig ako. (I helped.)",
                "Naghambal sia. (He/she spoke.)",
                "Mabulig kita. (Let's help. / We will help.)"
            ]
        }
    ],
