    "grammar": [
        {
            "title": "Ilonggo Pronouns",
            "description": "Ilonggo has a special distinction in the 'we' pronoun: 'Kami' excludes the person you're talking to, while 'Kita' includes them. English doesn't make this distinction!",
            "examples": [
                "Kami makadto. (We will go — but NOT you.)",
                "Kita makadto. (We will go — you too!)",
                "Kamo = you (plural, like 'y'all')",
                "Sila = they/them"
            ]
        },
        {
            "title": "Negation: Indi vs Wala",
            "description": "Ilonggo has two words for 'no/not'. 'Indi' negates future or general actions. 'Wala' negates past actions or denies the existence of something.",
            "examples": [
                "Indi ako makaon. (I will not eat. / I cannot eat.)",
                "Wala ako nagkaon. (I did not eat.)",
                "Wala siya. (He/She is not here.)"
            ]
        },
        {
            "title": "'May' — There is / To have",
            "description": "'May' expresses existence or possession. It's like saying 'there is' or meaning someone 'has' something.",
            "examples": [
                "May tubig. (There is water.)",
                "May plete ako. (I have fare money.)"
            ]
        }
    ],
