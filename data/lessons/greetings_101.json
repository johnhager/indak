    "grammar": [
        {
            "title": "Basic Particles ('Ang')",
            "description": "'Ang' is a subject marker used to point out the focus of the sentence. Think of it like 'the' in English.",
            "examples": [
                "Ano ang ngalan mo? (What is your name?)"
            ]
        },
        {
            "title": "Pronouns",
            "description": "'Ako' means 'I' or 'Me'. 'Ka' means 'You'. 'Mo' means 'Your'. They declare a state or possession.",
            "examples": [
                "Maayo ako. (I am good.)",
                "Halong ka. (You take care.)"
            ]
        },
        {
            "title": "Emphasis & Agreement",
            "description": "'Gid' adds emphasis (very/really), and 'Man' expresses agreement (also/too).",
            "examples": [
                "Salamat gid. (Thank you very much.)",
                "Maayo man ako. (I am good too.)"
            ]
        }
    ],
