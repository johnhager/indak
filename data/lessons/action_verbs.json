    "grammar": [
        {
            "title": "Action Verbs Review: nag- / naga- / mag-",
            "description": "By now you know the prefix system. Let's apply it to movement and activity verbs. Remember: nag- = past, naga- = present, mag- = future.",
            "examples": [
                "Naglakat ako. (I walked.)",
                "Nagalakat ako. (I am walking.)",
                "Maglakat ako. (I will walk.)"
            ]
        },
        {
            "title": "Giving Commands",
            "description": "To give a command (imperative), use the root form of the verb alone, or add 'mag-' at the start.",
            "examples": [
                "Lakat! (Walk!)",
                "Lingkod! (Sit!)",
                "Tindog! (Stand!)",
                "Pahuway anay. (Rest first.)"
            ]
        },
        {
            "title": "Going somewhere with Kadto",
            "description": "'Kadto' is the root for 'to go (to a far place)'. Combined with 'sa', it tells where you're going.",
            "examples": [
                "Nagkadto ako sa merkado. (I went to the market.)",
                "Magkadto kita sa baybayon. (Let's go to the beach.)"
            ]
        }
    ],
