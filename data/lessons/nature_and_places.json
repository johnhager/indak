    "grammar": [
        {
            "title": "Describing Weather & Nature",
            "description": "To describe weather or natural conditions in Ilonggo, you use the adjective directly. The 'ma-' prefix on adjectives like 'mainit' and 'mabugnaw' means 'is [quality]'.",
            "examples": [
                "Mainit karon. (It is hot today.)",
                "Mabugnaw ang dagat. (The sea is cold.)",
                "Damo ang ulan. (There is a lot of rain.)"
            ]
        },
        {
            "title": "Combining Location Words",
            "description": "Use 'sa' before a place noun to say where something is or where you're going.",
            "examples": [
                "Nagpunta ako sa baybayon. (I went to the beach.)",
                "Diin ang bukid? (Where is the mountain?)",
                "Maayo ang hangin sa dagat. (The wind at the sea is good.)"
            ]
        }
    ],
