    "grammar": [
        {
            "title": "Meal Words",
            "description": "Ilonggo has specific words for each meal of the day. These are nouns, so they work with 'ang' as the subject marker.",
            "examples": [
                "Palamahaw = Breakfast",
                "Panyaga = Lunch (borrowed from Spanish 'almuerzo' region, varies)",
                "Panyapon = Dinner",
                "Nagkaon ako sang palamahaw. (I ate breakfast.)"
            ]
        },
        {
            "title": "Describing Food with Namit",
            "description": "'Namit' means delicious. It directly precedes or follows the noun it describes. Adjectives in Ilonggo can come before or after the thing they describe.",
            "examples": [
                "Namit ang isda. (The fish is delicious.)",
                "Namit gid! (Really delicious! — adding 'gid' for emphasis)"
            ]
        }
    ],
