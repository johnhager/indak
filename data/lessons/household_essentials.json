    "grammar": [
        {
            "title": "The 'Ma-' Adjective Prefix",
            "description": "To turn a root word into an adjective meaning 'is [quality]', add the prefix 'ma-'. This is how Ilonggo forms most descriptive words.",
            "examples": [
                "Dako = Big → Madako = It is big.",
                "Maayo = Good (already has ma- built in!)",
                "The adjective comes BEFORE ang + noun: Madako ang balay. (The house is big.)"
            ]
        },
        {
            "title": "Verb Tenses Applied to Lesson Verbs",
            "description": "Practice the nag-/naga-/mag- prefix system you learned with these new verbs: Kaon (eat), Inom (drink), Tulog (sleep).",
            "examples": [
                "PAST: Nagkaon ako. (I ate.)",
                "PRESENT: Nagakaon ako. (I am eating.)",
                "FUTURE: Magkaon ako. (I will eat.)",
                "PAST: Naginom sila. (They drank.)",
                "FUTURE: Magtulog ako. (I will sleep.)"
            ]
        }
    ],
