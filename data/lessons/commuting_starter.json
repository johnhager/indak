    "grammar": [
        {
            "title": "Location Marker: 'Sa'",
            "description": "'Sa' works like 'to', 'at', or 'in' for places. Use it before a destination or location.",
            "examples": [
                "Sakay sa jeep. (Get on the jeepney.)",
                "Naganaog ako sa jeep. (I am getting off the jeepney.)"
            ]
        },
        {
            "title": "Object Marker: 'Sang'",
            "description": "'Sang' is used before a noun to mark it as the object of the action. Similar to 'the' in English, but specifically for things being acted upon.",
            "examples": [
                "Ano ang plete sang jeep? (What is the jeepney fare?)"
            ]
        },
        {
            "title": "Location Words: Diri / Didto",
            "description": "'Diri' means 'here' (close to you). 'Didto' means 'there' (far away).",
            "examples": [
                "Naog diri. (Get off here! — bare command)",
                "Sakay didto. (Get on there.)"
            ]
        },
        {
            "title": "Verb Tenses: The Prefix System",
            "description": "Ilonggo doesn't use separate words for tense like 'was' or 'will'. Instead, you change the PREFIX at the start of the verb. There are three main ones to learn:",
            "examples": [
                "IMPERATIVE (command / base form): Sakay! (Get on!)",
                "PAST (nag-): Nagsakay ako. (I got on / I rode.)",
                "PRESENT (naga-): Nagasakay ako. (I am riding.)",
                "FUTURE (mag-): Magsakay ako. (I will ride.)"
            ]
        },
        {
            "title": "Verb Tenses: Practice with Naog",
            "description": "Let's apply the same prefix pattern to 'Naog' (the root word for getting off). Note: the 'mag-' prefix contracts with 'n' — so mag + naog = Manaog.",
            "examples": [
                "IMPERATIVE (bare root): Naog! (Get off!)",
                "PAST (nag-): Nagnaog ako. (I got off.)",
                "PRESENT (naga-): Naganaog ako. (I am getting off.)",
                "FUTURE (mag+naog): Manaog ako. (I will get off.)"
            ]
        }
    ],
