    "grammar": [
        {
            "title": "Location Marker: 'Sa'",
            "description": "'Sa' works like 'to', 'at', or 'in' for places. Use it before a destination or location.",
            "examples": [
                "Sakay sa jeep. (Get on the jeepney.)",
                "Manaog sa diri. (Get off here.)"
            ]
        },
        {
            "title": "Object Marker: 'Sang'",
            "description": "'Sang' is used before a noun to mark it as the object of the action. Similar to 'the' in English, but specifically for things being acted upon.",
            "examples": [
                "Ano ang plete sang jeep? (What is the jeepney fare?)"
            ]
        },
        {
            "title": "Location Words: Diri / Didto",
            "description": "'Diri' means 'here' (close to you). 'Didto' means 'there' (far away).",
            "examples": [
                "Manaog diri. (Get off here.)",
                "Sakay didto. (Get on there.)"
            ]
        }
    ],
